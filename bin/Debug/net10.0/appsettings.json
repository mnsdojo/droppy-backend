{
  "AWS": {
    "Region": "us-east-1",
    "S3": {
      "BucketName": "droppy-mini-bucket"
    }
  },

  "FileUpload": {
    "MaxFileSizeMB": 50,
    "AllowedExtensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".pdf",
      ".txt",
      ".zip"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}

